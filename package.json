{
  "name": "viksit-project-root",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Civic Resolution Platform - Monorepo Workspace",
  "scripts": {
    "dev": "concurrently --names \"FRONTEND,BACKEND\" --prefix-colors \"blue,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm run build --prefix frontend",
    "seed:backend": "npm run seed --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
